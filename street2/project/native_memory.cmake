# Derive a Street 2-only memory-layout variant. The shared runtime stays untouched.
set(_kernel_dir "${XBOXRECOMP_DIR}/src/kernel")
file(READ "${_kernel_dir}/xbox_memory_layout.c" _layout)
string(REPLACE "\r\n" "\n" _layout "${_layout}")
set(_start_mark "static void xbox_Nv2aAckStart(void)\n{")
set(_end_mark "/* Separate allocation for Xbox kernel address space")
string(FIND "${_layout}" "${_start_mark}" _start)
string(FIND "${_layout}" "${_end_mark}" _end)
if(_start LESS 0 OR _end LESS _start)
    message(FATAL_ERROR "Native memory adapter no longer matches the shared runtime")
endif()
string(SUBSTRING "${_layout}" 0 ${_start} _prefix)
string(SUBSTRING "${_layout}" ${_end} -1 _suffix)
set(_native "${_prefix}static void xbox_Nv2aAckStart(void)\n{\n    fprintf(stderr, \"  Native PC: NV2A polling/ack/device threads not started\\n\");\n}\n\n${_suffix}")
set(_native_path "${CMAKE_BINARY_DIR}/street2_native_memory_layout.c")
if(EXISTS "${_native_path}")
    file(READ "${_native_path}" _old_native)
endif()
if(NOT _native STREQUAL _old_native)
    file(WRITE "${_native_path}" "${_native}")
endif()
get_target_property(_sources xbox_kernel SOURCES)
set(_native_sources "")
foreach(_source IN LISTS _sources)
    get_filename_component(_name "${_source}" NAME)
    if(_name STREQUAL "xbox_memory_layout.c")
        list(APPEND _native_sources "${_native_path}")
    elseif(IS_ABSOLUTE "${_source}")
        list(APPEND _native_sources "${_source}")
    else()
        list(APPEND _native_sources "${_kernel_dir}/${_source}")
    endif()
endforeach()
set_property(TARGET xbox_kernel PROPERTY SOURCES "${_native_sources}")
